<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release 构建默认严格仅允许 HTTPS 安全连接，禁止全局明文 HTTP -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
