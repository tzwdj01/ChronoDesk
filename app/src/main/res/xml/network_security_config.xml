<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许系统建立所需 HTTP 连接，由应用内客户端 (GrafanaApiClient) 严格落实私有内网地址范围和用户开关校验 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
