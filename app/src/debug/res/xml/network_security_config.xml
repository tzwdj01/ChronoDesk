<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug 调试开发构建：允许在内网联调自建 Grafana 或开发服务器时使用 HTTP -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
